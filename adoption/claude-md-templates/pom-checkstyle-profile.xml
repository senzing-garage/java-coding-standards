<!--
  Drop-in checkstyle profile for adopting projects.

  Suppressions wiring is handled inside
  .java-coding-standards/checkstyle/senzing-checkstyle.xml itself,
  via two embedded <module name="SuppressionFilter"> entries — one
  for the shared baseline (always present) and one optional entry
  that picks up a project-local checkstyle-suppressions-local.xml
  at the project root if it exists. Consumers therefore only need
  to set <configLocation>; no <suppressionsLocation> required.

  Earlier versions of this profile passed both paths through the
  plugin's <suppressionsLocation> parameter as a comma-separated
  list. maven-checkstyle-plugin 3.6.0 silently honored only the
  first path, breaking the layered design — the embedded-filter
  approach above replaces it.

  0.5.3 adds <includeTestSourceDirectory>true</...>. Without it
  maven-checkstyle-plugin defaults to false and silently skips
  src/test/java — the shared LineLength rule fires on test
  sources but is ignored at gate time, so formatter advisories
  in test code stay toothless. Consumers upgrading from 0.5.2
  must clean up any pre-existing test-source overflows (manual
  literal splits or project-local <suppress> entries in
  checkstyle-suppressions-local.xml) before adopting.
-->
<profile>
  <id>checkstyle</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${project.basedir}/.java-coding-standards/checkstyle/senzing-checkstyle.xml</configLocation>
          <encoding>UTF-8</encoding>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <linkXRef>false</linkXRef>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>validate</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</profile>
