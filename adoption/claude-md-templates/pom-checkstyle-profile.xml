<!--
  Drop-in checkstyle profile for adopting projects.

  Layered <suppressionsLocation>: the shared
  senzing-checkstyle-suppressions.xml ships in the standards-repo
  submodule; the project-local checkstyle-suppressions-local.xml is
  optional and lives next to the pom — it carries project-specific
  suppressions like generated-file carve-outs.

  If the project has no checkstyle-suppressions-local.xml,
  delete the second <suppressionsLocation> line.
-->
<profile>
  <id>checkstyle</id>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${project.basedir}/.java-coding-standards/checkstyle/senzing-checkstyle.xml</configLocation>
          <encoding>UTF-8</encoding>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <linkXRef>false</linkXRef>
          <suppressionsLocation>${project.basedir}/.java-coding-standards/checkstyle/senzing-checkstyle-suppressions.xml</suppressionsLocation>
          <suppressionsLocation>${project.basedir}/checkstyle-suppressions-local.xml</suppressionsLocation>
        </configuration>
        <executions>
          <execution>
            <id>validate</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</profile>
